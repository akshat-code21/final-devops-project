server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri /index.html;
  }

  # /api/ is proxied to the backend. BACKEND_HOST and DNS_RESOLVER are injected
  # per environment and rendered at container start by nginx's envsubst entrypoint:
  #   - Docker Compose: BACKEND_HOST=backend, DNS_RESOLVER=127.0.0.11 (Dockerfile defaults)
  #   - Kubernetes:     BACKEND_HOST=<release>-backend.<namespace>.svc.cluster.local
  #                     (fully qualified -- nginx's resolver directive does raw DNS
  #                     with NO search-domain expansion, so a short name would NXDOMAIN)
  #                     and DNS_RESOLVER=kube-dns IP (both set in the Helm chart)
  # The proxy_pass variable + explicit resolver forces RUNTIME DNS resolution,
  # so nginx starts even if the backend is not yet reachable and picks it up
  # when it appears (requests 502 in the gap instead of crashing the pod).
  resolver ${DNS_RESOLVER} valid=10s ipv6=off;
  set $backend_upstream "${BACKEND_HOST}:8000";
  location /api/ {
    proxy_pass http://$backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}
